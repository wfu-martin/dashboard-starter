# Copy this file to .streamlit/secrets.toml and fill in the password.
# secrets.toml is in .gitignore, so it never reaches GitHub.
# On Streamlit Community Cloud, paste the same lines into the app's
# Settings -> Secrets box instead.
#
# The encryption settings are not here on purpose: dashboard/db.py adds them
# (sslmode=verify-full, with the certifi list of trusted authorities), so
# they are the same on every laptop and on Community Cloud.

[connections.db]
dialect = "postgresql"
driver = "psycopg"
host = "datalake.databasevoyager.com"
port = 5432
database = "vinyl_vault"            # your team's database
username = "student"
password = "PASTE-THE-CLASS-PASSWORD-HERE"
